<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="school.coda.remy_axel_ethan.projet_java.base.BaseController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Bienvenue dans la bataille javale!"/>

    <Label text="Entrez la taille du tableau (entre 6 et 26) :"/>

    <TextField fx:id="sizeInput" promptText="Taille (ex: 10)" maxWidth="100"/>

    <Button text="Jouer!" onAction="#launchGame"/>
</VBox>